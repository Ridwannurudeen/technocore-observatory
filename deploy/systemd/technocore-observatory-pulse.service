[Unit]
Description=Technocore Observatory unmetered pulse probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=technocore
Group=technocore
WorkingDirectory=/home/technocore/observatory
UMask=0027
ExecStart=/usr/bin/python3 /home/technocore/observatory/pulse_probe.py --base-url https://technocore.chat --telemetry-database /home/technocore/observatory/telemetry.sqlite3 --once
TimeoutStartSec=90s
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/home/technocore/observatory
